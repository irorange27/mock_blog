{
  "name": "niina-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "new-post": "node scripts/new-post.js",
    "new-moment": "node scripts/new-moment.js",
    "media": "node scripts/media.mjs",
    "subset-font": "bash scripts/subset-font.sh",
    "build": "nuxt build",
    "dev": "node -e 'require(\"node:fs\").rmSync(\".output\", { recursive: true, force: true })' && nuxt dev",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "typecheck:ci": "node scripts/typecheck-ci.mjs",
    "typecheck:report": "node scripts/typecheck-ci.mjs --report",
    "typecheck:update": "node scripts/typecheck-ci.mjs --update",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "nuxt generate && wrangler deploy",
    "deploy": "deploy / publish 都是 pnpm 内置命令名，会被 pnpm 自己截走。请用 pnpm cf:deploy",
    "postinstall": "nuxt prepare && (git config core.hooksPath .githooks || true)"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "@coderline/alphatab-vite": "^1.9.0",
    "@nuxt/content": "^3.17.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.20",
    "abcjs": "^6.7.3",
    "nuxt": "^4.6.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rss": "^1.2.2",
    "vue": "^3.5.45",
    "vue-easy-lightbox": "^1.19.0",
    "wavesurfer.js": "^8.1.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/test-utils": "^4.4.0",
    "@vue/test-utils": "^2.6.0",
    "better-sqlite3": "^13.2.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24"
  }
}
